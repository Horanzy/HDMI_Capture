IO_LOC "DDR3_DQ[6]" F10;  IO_LOC "DDR3_DQ[7]" A10;
IO_LOC "DDR3_DQ[8]" C13;  IO_LOC "DDR3_DQ[9]" A13;
IO_LOC "DDR3_DQ[10]" E11; IO_LOC "DDR3_DQ[11]" F11;
IO_LOC "DDR3_DQ[12]" C12; IO_LOC "DDR3_DQ[13]" D12;
IO_LOC "DDR3_DQ[14]" B14; IO_LOC "DDR3_DQ[15]" A14;
