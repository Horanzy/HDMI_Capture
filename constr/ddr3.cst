IO_LOC "DDR3_A[12]" A5;  IO_LOC "DDR3_A[13]" B2;
IO_LOC "DDR3_BA[0]" D6;  IO_LOC "DDR3_BA[1]" A4;
IO_LOC "DDR3_BA[2]" D8;
IO_LOC "DDR3_RAS_N" G8;  IO_LOC "DDR3_CAS_N" F8;
IO_LOC "DDR3_WE_N" E8;   IO_LOC "DDR3_CS_N" E7;
IO_LOC "DDR3_CKE" C5;    IO_LOC "DDR3_ODT" F7;
IO_LOC "DDR3_RESET_N" A7;
IO_LOC "DDR3_CK_P" D9;   IO_LOC "DDR3_CK_N" C9;
IO_LOC "DDR3_DQ[0]" A12;  IO_LOC "DDR3_DQ[1]" B11;
IO_LOC "DDR3_DQ[2]" G9;   IO_LOC "DDR3_DQ[3]" G11;
