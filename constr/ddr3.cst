// ACG525 core-board DDR3 pinout, transcribed from the user-supplied DDR3.csv.
// All 48 DDR3 balls were checked against the GW5A-25 UG324 pinout table.
IO_LOC "DDR3_CLK_50M" T9;
IO_PORT "DDR3_CLK_50M" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "DDR3_A[0]" A3;   IO_LOC "DDR3_A[1]" A6;
IO_LOC "DDR3_A[2]" B3;   IO_LOC "DDR3_A[3]" C7;
