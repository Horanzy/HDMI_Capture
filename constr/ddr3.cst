IO_LOC "DDR3_DM[0]" F9; IO_LOC "DDR3_DM[1]" F13;

IO_PORT "DDR3_A[0]" IO_TYPE=SSTL15_I DRIVE=8; IO_PORT "DDR3_A[1]" IO_TYPE=SSTL15_I DRIVE=8;
