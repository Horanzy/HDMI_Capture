// ------------------------------------------------------------ IT68051 control (I2C master open-drain / HPD / reset / INT)
IO_LOC  "it68051_sysrstn" K2;  // output pad=U1.B35 bank=6 IOL12A // = netlist net 68051_SYSRSTN; IT68051 hardware reset (ext 22k+1uF RC)
IO_LOC  "it68051_int" K1;  // input pad=U1.B37 bank=6 IOL12B // = netlist net 68051_INT; IT68051 INT#/SCDT, open-drain, ext 10k pullup
IO_LOC  "it68051_pcsda" L2;  // inout pad=U1.B39 bank=6 IOL14A // = netlist net 68051_PCSDA; I2C SDA, open-drain, ext 10k pullup
IO_LOC  "it68051_pcscl" L1;  // inout pad=U1.B41 bank=6 IOL14B // = netlist net 68051_PCSCL; I2C SCL, open-drain, ext 10k pullup
IO_LOC  "it68051_hpd" N1;  // output pad=U1.B47 bank=6 IOL18B // = netlist net 68051_HPD; HDMI HPD via external Q3: LOW=assert(valid)
IO_PORT "it68051_sysrstn" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "it68051_int" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "it68051_pcsda" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "it68051_pcscl" IO_TYPE=LVCMOS33 PULL_MODE=UP;
