// ------------------------------------------------------------ FT601Q control
IO_LOC  "FT601_TXE_N" E16;  // input pad=U1.A78 bank=2 IOR16A // TX FIFO empty, low=space>=1 byte
IO_LOC  "FT601_WAKEUP_N" G16;  // input pad=U1.A87 bank=2 IOR22A // USB suspend flag, unused in v1
IO_LOC  "FT601_RESET_N" D18;  // output pad=U1.A89 bank=2 IOR12B // FT601 reset, ext 10k pullup+0.1uF
IO_LOC  "FT601_OE_N" D17;  // output pad=U1.A91 bank=2 IOR12A // output enable for FT601 DATA drive (cmd path)
IO_LOC  "FT601_RD_N" G14;  // output pad=U1.A93 bank=2 IOR7B // read strobe, active low (cmd path)
IO_LOC  "FT601_WR_N" F14;  // output pad=U1.A95 bank=2 IOR7A // write strobe, active low
IO_LOC  "FT601_SIWU_N" C18;  // input pad=U1.A97 bank=2 IOR9B // reserved, ext 10k pullup, unused in v1
IO_LOC  "FT601_RXF_N" C17;  // input pad=U1.A99 bank=2 IOR9A // RX FIFO full, low=data available (cmd path)
IO_PORT "FT601_TXE_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "FT601_WAKEUP_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "FT601_RESET_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "FT601_OE_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "FT601_RD_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "FT601_WR_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "FT601_SIWU_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "FT601_RXF_N" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
