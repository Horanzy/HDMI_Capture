// capture.cst -- Gowin GW5A-LV25UG324 (UG324 package) constraints
// USB HDMI capture card, FPGA = U1.  AUTO-GENERATED by ia_gen_cst.py
// from review/final_bank_table_full.csv (regenerated from V1.4 netlist)
// and cross-checked net-by-net against V1.4.tel (U1 connections).
//
// All IO: LVCMOS33 @ 3.3V.  Banks 0/1 (1.5V DDR3 domain) are NOT used.
// JTAG balls (A94/A96/A98/A100 = FPGA_TDO/TDI/TMS/TCK) are device-dedicated;
// they are not user IO and are intentionally absent here.
//
// QD bit mapping (V1.4 netlist net names, = IT68051 dual-pixel DDR):
//   A_B2..A_B11  = QD[9:0]   pixel A Blue  (bits 2..11)
//   A_G2..A_G11  = QD[19:10] pixel A Green
//   A_R2..A_R11  = QD[29:20] pixel A Red
//   B_B2..B_B11  = QD[39:30] pixel B Blue
//   B_G2..B_G11  = QD[49:40] pixel B Green
//   B_R2..B_R11  = QD[59:50] pixel B Red

// ------------------------------------------------------------ Clock inputs (direct global clock balls, GCLKT capable)
IO_LOC  "FT601_CLK" H4;  // input pad=U1.B10 bank=7 IOT1A // FT601 100MHz FIFO bus clock out (GCLKT_15)
IO_LOC  "RX_PCLK" M10;  // input pad=U1.B84 bank=5 IOB26A // IT68051 PCLK, dual-edged data strobe (GCLKT_9B)
IO_PORT "FT601_CLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "RX_PCLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// ------------------------------------------------------------ IT68051 video syncs (single-edge, sampled at PCLK rising edge)
IO_LOC  "RX_VSYNC" P2;  // input pad=U1.B49 bank=6 IOL21A // IT68051 separate syncs, single-edge
IO_LOC  "RX_HSYNC" P1;  // input pad=U1.B51 bank=6 IOL21B // IT68051 separate syncs, single-edge
IO_LOC  "RX_DE" M8;  // input pad=U1.B61 bank=5 IOB24A // IT68051 separate syncs, single-edge
IO_PORT "RX_VSYNC" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "RX_HSYNC" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "RX_DE" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

